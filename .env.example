# LLM Backend — set to "groq" or "ollama"
LLM_BACKEND=groq_or_ollama

# Groq API (get your key at console.groq.com)
GROQ_API_KEY=gsk_your_api_key_here
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama (local development — run `ollama serve` first)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=llama3.1:8b
OLLAMA_FAST_MODEL=llama3.2:3b

# Pipeline settings
REVIEWER_TEMPERATURE=0.3
DETERMINISTIC_TEMPERATURE=0.0
SELF_CONSISTENCY_RUNS=3
MAX_DOCUMENT_CHARS=80000
MAX_SECTION_CHARS=15000

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
SECRET_KEY=replace_with_a_long_random_secret_string
