# OpenRouter (sole LLM provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.7-plus

# Pipeline settings
REVIEWER_TEMPERATURE=0.3
DETERMINISTIC_TEMPERATURE=0.0
SELF_CONSISTENCY_RUNS=3
MAX_DOCUMENT_CHARS=80000
MAX_SECTION_CHARS=15000

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
SECRET_KEY=replace_with_a_long_random_secret_string

# Database (Postgres — see docker-compose.yml for local dev)
DATABASE_URL=postgresql+asyncpg://eval_user:eval_password@localhost:5432/eval_platform
