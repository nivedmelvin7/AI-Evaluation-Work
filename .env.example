# OpenRouter (sole LLM provider)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-v4-pro

# Pipeline settings
REVIEWER_TEMPERATURE=0.3
DETERMINISTIC_TEMPERATURE=0.0
SELF_CONSISTENCY_RUNS=3
MAX_DOCUMENT_CHARS=200000
MAX_SECTION_CHARS=15000
MAX_UPLOAD_BYTES=10485760

# Server
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_ENVIRONMENT=development
SECRET_KEY=replace_with_a_long_random_secret_string
FRONTEND_URL=http://localhost:5173
ENABLE_API_DOCS=true
LOG_TO_FILE=true

# Authentication
# Set AUTH_COOKIE_SECURE=true once the app is served over HTTPS.
AUTH_COOKIE_NAME=assessment_session
AUTH_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_SECURE=false
# Create a Google OAuth Web application and set its authorised redirect URI to
# GOOGLE_REDIRECT_URI before enabling the Google sign-in button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Database (Postgres — see docker-compose.yml for local dev)
POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=eval_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional full managed-Postgres URL. When set, this takes precedence over the
# POSTGRES_* connection fields above.
DATABASE_URL=
DATABASE_SSL_REQUIRED=false
